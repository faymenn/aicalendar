[Unit]
Description = gunicorn service to server api
After = network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/aicalendar
Environment="PATH=/home/ec2-user/aicalendar/venv/bin"
ExecStart=/home/ec2-user/aicalendar/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker app.main:app --bind 0.0.0.0:8080

[Install]
WantedBy=multi-user.target